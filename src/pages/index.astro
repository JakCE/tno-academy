---
// src/pages/index.astro — Hub: Servicios Educativos The Number One
import "../styles/global.css";
import JobModal from "../components/JobModal.astro";

const lang = (Astro.currentLocale ?? "es") as "es" | "en";

const t = {
  es: {
    title: "Servicios Educativos The Number One | Atalaya, Ucayali",
    desc: "Servicios Educativos The Number One: Academia de reforzamiento escolar y cursos de computación, ofimática y herramientas digitales con certificado en Atalaya, Ucayali.",
    location: "Atalaya, Ucayali — Perú",
    heading: "Servicios Educativos",
    headingHighlight: "The Number One",
    subheading: "Más de 10 años formando personas en Atalaya. Elige el servicio que necesitas.",
    card1_badge: "Nuevo servicio",
    card1_title: "Cursos & Talleres",
    card1_desc: "Cursos prácticos de computación, ofimática y herramientas digitales. Con certificado de participación al finalizar.",
    card1_items: ["Computación básica e Internet","Ofimática: Word, Excel, PowerPoint","Excel avanzado para el trabajo","Diseño digital con Canva","Google Workspace","Herramientas para docentes"],
    card1_cta: "Ver cursos disponibles",
    card2_badge: "+10 años de experiencia",
    card2_title: "Academia The Number One",
    card2_desc: "Nivelación escolar, preparación para COAR, Beca 18 y preuniversitario. Referentes en matemática y comunicación en Atalaya.",
    card2_items: ["Nivelación Primaria y Secundaria","Preparación COAR y Beca 18","Preuniversitario","Matemática especializada","Comunicación y comprensión lectora","500+ estudiantes formados"],
    card2_cta: "Ver academia",
    card3_badge: "Nuevo servicio",
    card3_title: "Servicios Universitarios",
    card3_desc: "Asesoría de tesis, reforzamiento en matemáticas universitarias y apoyo en trabajos académicos. Calidad y reserva absoluta.",
    card3_items: ["Asesoría de Tesis (APA, Vancouver)","Cálculo, Álgebra y Estadística","Informes técnicos y monografías","Proyectos y guías prácticas","Presentaciones ejecutivas","Entrega puntual y reserva total"],
    card3_cta: "Ver servicios universitarios",
    footer: "Servicios Educativos The Number One — Atalaya, Ucayali, Perú",
    rights: "Todos los derechos reservados.",
    switchLang: "EN",
    switchHref: "/en",
  },
  en: {
    title: "Educational Services The Number One | Atalaya, Ucayali",
    desc: "Educational Services The Number One: School reinforcement academy and computing, office software and digital tools courses with certificate in Atalaya, Ucayali.",
    location: "Atalaya, Ucayali — Peru",
    heading: "Educational Services",
    headingHighlight: "The Number One",
    subheading: "Over 10 years training people in Atalaya. Choose the service you need.",
    card1_badge: "New service",
    card1_title: "Courses & Workshops",
    card1_desc: "Practical courses in computing, office software and digital tools. With a participation certificate upon completion.",
    card1_items: ["Basic Computing & Internet","Office Suite: Word, Excel, PowerPoint","Advanced Excel for Work","Digital Design with Canva","Google Workspace","Digital Tools for Teachers"],
    card1_cta: "View available courses",
    card2_badge: "10+ years of experience",
    card2_title: "The Number One Academy",
    card2_desc: "School leveling, preparation for COAR, Scholarship 18 and pre-university. Reference in mathematics and communication in Atalaya.",
    card2_items: ["Primary & Secondary leveling","COAR and Scholarship 18 prep","Pre-university","Specialized Mathematics","Communication and reading","500+ students trained"],
    card2_cta: "View academy",
    card3_badge: "New service",
    card3_title: "University Services",
    card3_desc: "Thesis advisory, university mathematics tutoring and academic work support. Quality and full confidentiality.",
    card3_items: ["Thesis Advisory (APA, Vancouver)","Calculus, Algebra & Statistics","Technical reports and monographs","Projects and practical guides","Executive presentations","On-time delivery, full confidentiality"],
    card3_cta: "View university services",
    footer: "Educational Services The Number One — Atalaya, Ucayali, Peru",
    rights: "All rights reserved.",
    switchLang: "ES",
    switchHref: "/",
  },
}[lang];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`https://thenumberone.com.pe${lang === "en" ? "/en" : "/"}`} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.desc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://thenumberone.com.pe/se_logo-sf.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Dark mode anti-flash -->
    <script is:inline>
      (function(){var t=localStorage.getItem('theme'),d=window.matchMedia('(prefers-color-scheme: dark)').matches;if(t==='dark'||(!t&&d))document.documentElement.classList.add('dark');})();
    </script>

    <!-- GTM -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-53V7LT6M');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/icono.ico" />
    <style>:root{--font-heading:'Sora',sans-serif;--font-body:'Nunito',sans-serif;}body{font-family:var(--font-body);}h1,h2,h3,h4{font-family:var(--font-heading);}</style>
  </head>

  <body class="min-h-screen bg-slate-950 text-white antialiased">
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-53V7LT6M" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <!-- Modal convocatoria laboral -->
    <JobModal />

    <!-- Banner convocatoria (persiste tras cerrar el modal) -->
    <div id="job-banner" class="relative z-40 w-full bg-amber-500 text-slate-900 hidden">
      <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-between gap-4">
        <a
          href={`https://wa.me/51929469555?text=${encodeURIComponent(lang === "en" ? "Hello, I'm interested in the *Secretary* position at Educational Services The Number One. Can you give me more information?" : "Hola, me interesa la convocatoria para *Secretaria/Secretario* en Servicios Educativos The Number One. ¿Pueden darme más información sobre los requisitos y el proceso de postulación?")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm font-bold hover:underline"
        >
          <span class="text-base">📢</span>
          {lang === "en" ? "We're hiring: Secretary position open — Tap to apply via WhatsApp" : "Convocatoria: Buscamos Secretaria/Secretario — Toca para postular por WhatsApp"}
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
        <button id="job-banner-close" aria-label="Cerrar banner" class="shrink-0 text-slate-900/60 hover:text-slate-900 transition-colors text-lg leading-none">✕</button>
      </div>
    </div>

    <!-- Fondo decorativo -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[120px]"></div>
      <div class="absolute -bottom-40 -right-40 w-[600px] h-[600px] bg-violet-600/10 rounded-full blur-[120px]"></div>
    </div>

    <div class="relative min-h-screen flex flex-col">

      <!-- Header -->
      <header class="flex-none px-6 py-6 flex items-center justify-between max-w-6xl mx-auto w-full">
        <img src="/se_logo-sf.png" alt="Servicios Educativos The Number One" class="h-12 w-auto brightness-200" />
        <div class="flex items-center gap-3">
          <!-- Lang switch -->
          <a href={t.switchHref} class="w-9 h-9 rounded-xl flex items-center justify-center text-xs font-bold text-slate-400 hover:text-white border border-slate-700 hover:border-slate-500 transition-all">
            {t.switchLang}
          </a>
          <!-- Dark toggle -->
          <button id="hub-theme-toggle" aria-label="Toggle theme" class="w-9 h-9 rounded-xl flex items-center justify-center text-slate-400 hover:text-white border border-slate-700 hover:border-slate-500 transition-all">
            <svg id="hub-sun" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
            <svg id="hub-moon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" /></svg>
          </button>
          <a href="https://wa.me/51929469555?text=Hola,%20quiero%20información%20sobre%20los%20servicios%20educativos" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-500 text-white text-sm font-bold px-4 py-2.5 rounded-xl transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
        </div>
      </header>

      <!-- Hero texto -->
      <div class="flex-none text-center px-6 pt-6 pb-10">
        <p class="text-blue-400 text-sm font-semibold tracking-widest uppercase mb-3">{t.location}</p>
        <h1 class="text-3xl md:text-5xl font-extrabold text-white leading-tight mb-4">
          {t.heading}<br />
          <span class="bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent">{t.headingHighlight}</span>
        </h1>
        <p class="text-slate-400 text-base md:text-lg max-w-xl mx-auto">{t.subheading}</p>
      </div>

      <!-- Cards -->
      <main class="flex-1 px-4 pb-16 max-w-6xl mx-auto w-full">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

          <!-- Cursos -->
          <a href={lang === "en" ? "/en/cursos" : "/cursos"} class="group relative flex flex-col bg-slate-900 border border-slate-800 hover:border-violet-500/60 rounded-3xl p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-violet-500/10 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-violet-600/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-3xl pointer-events-none"></div>
            <div class="w-14 h-14 rounded-2xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center mb-6 group-hover:bg-violet-500/20 transition-colors duration-300">
              <svg class="w-7 h-7 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
            </div>
            <span class="inline-flex items-center text-xs font-bold text-violet-400 bg-violet-500/10 border border-violet-500/20 px-3 py-1 rounded-full w-fit mb-4">{t.card1_badge}</span>
            <h2 class="text-2xl font-extrabold text-white mb-3 group-hover:text-violet-200 transition-colors duration-200">{t.card1_title}</h2>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">{t.card1_desc}</p>
            <ul class="space-y-2 text-sm text-slate-400 mb-8 flex-1">
              {t.card1_items.map(item => (
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-violet-400 shrink-0"></span>{item}</li>
              ))}
            </ul>
            <div class="inline-flex items-center gap-2 bg-violet-600 group-hover:bg-violet-500 text-white font-bold text-sm px-6 py-3 rounded-xl transition-all duration-200 w-fit">
              {t.card1_cta}
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </div>
          </a>

          <!-- Academia -->
          <a href={lang === "en" ? "/en/academia" : "/academia"} class="group relative flex flex-col bg-slate-900 border border-slate-800 hover:border-blue-500/60 rounded-3xl p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-blue-500/10 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-600/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-3xl pointer-events-none"></div>
            <div class="w-14 h-14 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mb-6 group-hover:bg-blue-500/20 transition-colors duration-300">
              <svg class="w-7 h-7 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" /></svg>
            </div>
            <span class="inline-flex items-center text-xs font-bold text-blue-400 bg-blue-500/10 border border-blue-500/20 px-3 py-1 rounded-full w-fit mb-4">{t.card2_badge}</span>
            <h2 class="text-2xl font-extrabold text-white mb-3 group-hover:text-blue-200 transition-colors duration-200">{t.card2_title}</h2>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">{t.card2_desc}</p>
            <ul class="space-y-2 text-sm text-slate-400 mb-8 flex-1">
              {t.card2_items.map(item => (
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-400 shrink-0"></span>{item}</li>
              ))}
            </ul>
            <div class="inline-flex items-center gap-2 bg-blue-600 group-hover:bg-blue-500 text-white font-bold text-sm px-6 py-3 rounded-xl transition-all duration-200 w-fit">
              {t.card2_cta}
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </div>
          </a>

          <!-- Universitarios -->
          <a href={lang === "en" ? "/en/universitarios" : "/universitarios"} class="group relative flex flex-col bg-slate-900 border border-slate-800 hover:border-emerald-500/60 rounded-3xl p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-emerald-500/10 overflow-hidden md:col-span-2 lg:col-span-1">
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-600/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-3xl pointer-events-none"></div>
            <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-6 group-hover:bg-emerald-500/20 transition-colors duration-300">
              <svg class="w-7 h-7 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" /></svg>
            </div>
            <span class="inline-flex items-center text-xs font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full w-fit mb-4">{t.card3_badge}</span>
            <h2 class="text-2xl font-extrabold text-white mb-3 group-hover:text-emerald-200 transition-colors duration-200">{t.card3_title}</h2>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">{t.card3_desc}</p>
            <ul class="space-y-2 text-sm text-slate-400 mb-8 flex-1">
              {t.card3_items.map(item => (
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>{item}</li>
              ))}
            </ul>
            <div class="inline-flex items-center gap-2 bg-emerald-600 group-hover:bg-emerald-500 text-white font-bold text-sm px-6 py-3 rounded-xl transition-all duration-200 w-fit">
              {t.card3_cta}
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </div>
          </a>

        </div>
      </main>

      <footer class="flex-none text-center px-6 py-6 border-t border-slate-800/60">
        <p class="text-slate-500 text-sm">© {new Date().getFullYear()} {t.footer}</p>
      </footer>

    </div>

    <script>
      // Dark mode toggle
      const toggle = document.getElementById("hub-theme-toggle");
      const sun    = document.getElementById("hub-sun");
      const moon   = document.getElementById("hub-moon");
      function syncHubIcons(isDark: boolean) {
        sun!.classList.toggle("hidden", !isDark);
        moon!.classList.toggle("hidden", isDark);
      }
      syncHubIcons(document.documentElement.classList.contains("dark"));
      toggle!.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        syncHubIcons(isDark);
      });

      // Banner: mostrar si ya cerró el modal (o si marcó "no volver a mostrar")
      const MODAL_KEY  = "tno_job_v1";
      const BANNER_KEY = "tno_job_banner_v1";
      const banner     = document.getElementById("job-banner");
      const bannerClose = document.getElementById("job-banner-close");

      function maybeShowBanner() {
        if (localStorage.getItem(BANNER_KEY) === "hidden") return;
        if (localStorage.getItem(MODAL_KEY) === "true") {
          // modal ya no se muestra → mostrar banner
          banner?.classList.remove("hidden");
        } else {
          // modal está activo → mostrar banner cuando el modal se cierre
          const backdrop = document.getElementById("job-backdrop");
          if (backdrop) {
            const obs = new MutationObserver(() => {
              if (backdrop.classList.contains("hidden")) {
                if (localStorage.getItem(BANNER_KEY) !== "hidden") {
                  banner?.classList.remove("hidden");
                }
                obs.disconnect();
              }
            });
            obs.observe(backdrop, { attributes: true, attributeFilter: ["class"] });
          }
        }
      }
      maybeShowBanner();

      bannerClose?.addEventListener("click", () => {
        banner?.classList.add("hidden");
        localStorage.setItem(BANNER_KEY, "hidden");
      });
    </script>
  </body>
</html>

---
// src/components/AnnouncementModal.astro
const lang = (Astro.currentLocale ?? "es") as "es" | "en";

const t = {
  es: {
    badge: "¡Inscripciones abiertas!",
    title: "Clases inician el",
    titleHighlight: "lunes 6 de abril",
    subtitle: 'Academia "The Number One" — Atalaya, Ucayali',
    grid: [
      { emoji: "📚", title: "Nivelación", desc: "Primaria y Secundaria" },
      { emoji: "🎯", title: "COAR & Beca 18", desc: "Preparación especializada" },
      { emoji: "➕", title: "Matemáticas", desc: "Aritmética, Álgebra, Geo, Trig, RM" },
      { emoji: "💬", title: "Letras", desc: "Comunicación, CL, Inglés" },
    ],
    cta: "¡Me inscribo ahora por WhatsApp! 💬",
    address: "📍 Jr. Rímac Mz 23 Lt 1f — Ref: Librería San Antonio,\nfrente a IE Hildebrando Fuentes (1er piso)",
    noShow: "No volver a mostrar",
  },
  en: {
    badge: "Enrollment open!",
    title: "Classes start on",
    titleHighlight: "Monday, April 6th",
    subtitle: '"The Number One" Academy — Atalaya, Ucayali',
    grid: [
      { emoji: "📚", title: "Leveling", desc: "Primary and Secondary" },
      { emoji: "🎯", title: "COAR & Scholarship 18", desc: "Specialized preparation" },
      { emoji: "➕", title: "Mathematics", desc: "Arithmetic, Algebra, Geo, Trig, MR" },
      { emoji: "💬", title: "Language Arts", desc: "Communication, RC, English" },
    ],
    cta: "Enroll now on WhatsApp! 💬",
    address: "📍 Jr. Rímac Mz 23 Lt 1f — Ref: Librería San Antonio,\nin front of IE Hildebrando Fuentes (1st floor)",
    noShow: "Don't show again",
  },
}[lang];
---

<div id="tno-backdrop" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
  <div id="tno-modal" class="relative bg-white dark:bg-slate-800 rounded-2xl w-full max-w-lg p-8 pt-10 text-center shadow-2xl max-h-[92vh] overflow-y-auto">

    <button id="tno-close" aria-label="Cerrar"
      class="absolute top-4 right-4 w-8 h-8 rounded-full bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-500 dark:text-slate-300 hover:text-gray-800 dark:hover:text-white flex items-center justify-center text-sm transition-colors">✕</button>

    <span class="inline-block bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300 text-xs font-bold uppercase tracking-widest px-4 py-1 rounded-full mb-4">
      {t.badge}
    </span>

    <h2 class="text-3xl font-extrabold text-gray-900 dark:text-white leading-tight mb-1">
      {t.title}<br /><span class="text-blue-700 dark:text-blue-400">{t.titleHighlight}</span>
    </h2>
    <p class="text-sm text-gray-400 dark:text-slate-500 mb-6">{t.subtitle}</p>

    <div class="grid grid-cols-2 gap-3 mb-6 text-left">
      {t.grid.map(item => (
        <div class="flex gap-2 items-start bg-gray-50 dark:bg-slate-700 border border-gray-200 dark:border-slate-600 rounded-xl p-3">
          <span class="text-base leading-none mt-0.5">{item.emoji}</span>
          <div>
            <strong class="block text-xs font-bold text-gray-900 dark:text-white">{item.title}</strong>
            <span class="text-xs text-gray-500 dark:text-slate-400">{item.desc}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="flex flex-wrap gap-2 justify-center mb-5">
      {["929 469 555", "949 544 537", "907 383 283"].map(tel => (
        <a href={`tel:+51${tel.replace(/\s/g,"")}`}
          class="bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800 text-blue-700 dark:text-blue-300 text-sm font-semibold px-4 py-1.5 rounded-lg hover:bg-blue-100 dark:hover:bg-blue-900/40 transition-colors">
          {tel}
        </a>
      ))}
    </div>

    <a href="https://wa.me/51929469555?text=Hola,%20quiero%20información%20sobre%20las%20inscripciones" target="_blank" rel="noopener noreferrer"
      class="block w-full bg-green-600 hover:bg-green-700 text-white font-bold text-base py-3.5 rounded-xl mb-4 transition-all hover:-translate-y-0.5">
      {t.cta}
    </a>

    <p class="text-xs text-gray-400 dark:text-slate-500 leading-relaxed mb-4" set:html={t.address.replace("\n","<br/>")} />

    <label class="flex items-center justify-center gap-2 text-xs text-gray-400 dark:text-slate-500 cursor-pointer">
      <input type="checkbox" id="tno-no-show" class="rounded" />
      {t.noShow}
    </label>
  </div>
</div>

<script>
  const KEY      = "tno_modal_v1";
  const backdrop = document.getElementById("tno-backdrop");
  const closeBtn = document.getElementById("tno-close");
  const noShow   = document.getElementById("tno-no-show") as HTMLInputElement;
  if (localStorage.getItem(KEY) === "true") backdrop?.classList.add("hidden");
  function close() {
    if (noShow?.checked) localStorage.setItem(KEY, "true");
    backdrop?.classList.add("hidden");
  }
  closeBtn?.addEventListener("click", close);
  backdrop?.addEventListener("click", (e) => { if (e.target === backdrop) close(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
</script>

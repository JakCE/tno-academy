---
// src/components/AnnouncementModal.astro
// Úsalo en Layout.astro: import AnnouncementModal from "./AnnouncementModal.astro"
// y pon <AnnouncementModal /> justo después de <body>
---

<div
  id="tno-backdrop"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm"
>
  <div
    id="tno-modal"
    class="relative bg-white rounded-2xl w-full max-w-lg p-8 pt-10 text-center shadow-2xl max-h-[92vh] overflow-y-auto"
  >
    <!-- Cerrar -->
    <button
      id="tno-close"
      aria-label="Cerrar"
      class="absolute top-4 right-4 w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 hover:text-gray-800 flex items-center justify-center text-sm transition-colors"
    >✕</button>

    <!-- Badge -->
    <span class="inline-block bg-amber-100 text-amber-800 text-xs font-bold uppercase tracking-widest px-4 py-1 rounded-full mb-4">
      ¡Inscripciones abiertas!
    </span>

    <!-- Título -->
    <h2 class="text-3xl font-extrabold text-gray-900 leading-tight mb-1">
      Clases inician el<br />
      <span class="text-blue-700">lunes 6 de abril</span>
    </h2>
    <p class="text-sm text-gray-400 mb-6">Academia "The Number One" — Atalaya, Ucayali</p>

    <!-- Info grid -->
    <div class="grid grid-cols-2 gap-3 mb-6 text-left">
      <div class="flex gap-2 items-start bg-gray-50 border border-gray-200 rounded-xl p-3">
        <span class="text-base leading-none mt-0.5">📚</span>
        <div>
          <strong class="block text-xs font-bold text-gray-900">Nivelación</strong>
          <span class="text-xs text-gray-500">Primaria y Secundaria</span>
        </div>
      </div>
      <div class="flex gap-2 items-start bg-gray-50 border border-gray-200 rounded-xl p-3">
        <span class="text-base leading-none mt-0.5">🎯</span>
        <div>
          <strong class="block text-xs font-bold text-gray-900">COAR & Beca 18</strong>
          <span class="text-xs text-gray-500">Preparación especializada</span>
        </div>
      </div>
      <div class="flex gap-2 items-start bg-gray-50 border border-gray-200 rounded-xl p-3">
        <span class="text-base leading-none mt-0.5">➕</span>
        <div>
          <strong class="block text-xs font-bold text-gray-900">Matemáticas</strong>
          <span class="text-xs text-gray-500">Aritmética, Álgebra, Geo, Trig, RM</span>
        </div>
      </div>
      <div class="flex gap-2 items-start bg-gray-50 border border-gray-200 rounded-xl p-3">
        <span class="text-base leading-none mt-0.5">💬</span>
        <div>
          <strong class="block text-xs font-bold text-gray-900">Letras</strong>
          <span class="text-xs text-gray-500">Comunicación, CL, Inglés</span>
        </div>
      </div>
    </div>

    <!-- Teléfonos -->
    <div class="flex flex-wrap gap-2 justify-center mb-5">
      <a href="tel:+51929469555" class="bg-blue-50 border border-blue-200 text-blue-700 text-sm font-semibold px-4 py-1.5 rounded-lg hover:bg-blue-100 transition-colors">929 469 555</a>
      <a href="tel:+51949544537" class="bg-blue-50 border border-blue-200 text-blue-700 text-sm font-semibold px-4 py-1.5 rounded-lg hover:bg-blue-100 transition-colors">949 544 537</a>
      <a href="tel:+51907383283" class="bg-blue-50 border border-blue-200 text-blue-700 text-sm font-semibold px-4 py-1.5 rounded-lg hover:bg-blue-100 transition-colors">907 383 283</a>
    </div>

    <!-- CTA -->
    <a
      href="https://wa.me/51929469555?text=Hola,%20quiero%20información%20sobre%20las%20inscripciones"
      target="_blank"
      rel="noopener noreferrer"
      class="block w-full bg-green-600 hover:bg-green-700 text-white font-bold text-base py-3.5 rounded-xl mb-4 transition-all hover:-translate-y-0.5"
    >¡Me inscribo ahora por WhatsApp! 💬</a>

    <!-- Dirección -->
    <p class="text-xs text-gray-400 leading-relaxed mb-4">
      📍 Jr. Rímac Mz 23 Lt 1f — Ref: Librería San Antonio,<br />
      frente a IE Hildebrando Fuentes (1er piso)
    </p>

    <!-- No mostrar de nuevo -->
    <label class="flex items-center justify-center gap-2 text-xs text-gray-400 cursor-pointer">
      <input type="checkbox" id="tno-no-show" class="rounded" />
      No volver a mostrar
    </label>
  </div>
</div>

<script>
  const KEY     = "tno_modal_v1";
  const backdrop = document.getElementById("tno-backdrop");
  const closeBtn = document.getElementById("tno-close");
  const noShow   = document.getElementById("tno-no-show") as HTMLInputElement;

  if (localStorage.getItem(KEY) === "true") backdrop?.classList.add("hidden");

  function close() {
    if (noShow?.checked) localStorage.setItem(KEY, "true");
    backdrop?.classList.add("hidden");
  }

  closeBtn?.addEventListener("click", close);
  backdrop?.addEventListener("click", (e) => { if (e.target === backdrop) close(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
</script>
---
// src/components/Stats.astro
import { Icon } from "astro-icon/components";

const stats = [
  {
    value: "10+",
    label: "Años de experiencia",
    description: "Pioneros en formación académica en Atalaya",
    icon: "heroicons:calendar-days",
  },
  {
    value: "500+",
    label: "Estudiantes formados",
    description: "Impactando el futuro de nuestra provincia",
    icon: "heroicons:users",
  },
  {
    value: "COAR",
    label: "Ingresos comprobados",
    description: "Estudiantes admitidos al Colegio de Alto Rendimiento",
    icon: "heroicons:academic-cap",
  },
  {
    value: "Univ.",
    label: "Ingreso superior",
    description: "Preparación para universidades del país",
    icon: "heroicons:building-library",
  },
];
---

<section id="stats" class="relative py-24 bg-blue-950 overflow-hidden">

  <!-- Decoración de fondo -->
  <div class="absolute inset-0 opacity-10 pointer-events-none"
    style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0); background-size: 32px 32px;">
  </div>
  <div class="absolute -top-40 -right-40 w-[500px] h-[500px] bg-blue-700 rounded-full blur-[130px] opacity-20 pointer-events-none"></div>
  <div class="absolute -bottom-40 -left-40 w-[400px] h-[400px] bg-blue-600 rounded-full blur-[120px] opacity-15 pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-6">

    <!-- Encabezado -->
    <div class="text-center max-w-2xl mx-auto mb-16" data-reveal>
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-blue-300 bg-blue-900 border border-blue-700 px-4 py-1.5 rounded-full mb-5">
        Nuestra trayectoria
      </span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-white leading-tight">
        Más de 10 años formando estudiantes en la
        <span class="text-blue-300"> provincia de Atalaya</span>,
        región Ucayali
      </h2>
      <p class="mt-5 text-blue-200/70 text-base leading-relaxed">
        Institución educativa referente en preparación para el COAR y
        universidades del país, comprometidos con el desarrollo académico de nuestra región.
      </p>
    </div>

    <!-- Grid de stats -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-blue-800/40 rounded-3xl overflow-hidden border border-blue-800/50">
      {stats.map((item, i) => (
        <div
          data-reveal
          data-reveal-delay={String(i + 1)}
          class="group bg-blue-950 hover:bg-blue-900/60 transition-colors duration-300 p-8 xl:p-10 flex flex-col gap-5"
        >
          <!-- Ícono -->
          <div class="w-12 h-12 rounded-2xl bg-blue-800 group-hover:bg-blue-700 border border-blue-700 flex items-center justify-center transition-colors duration-300">
            <Icon name={item.icon} class="w-5 h-5 text-blue-300" />
          </div>

          <!-- Número grande -->
          <div>
            <p class="text-5xl font-extrabold text-white tracking-tight leading-none mb-2">
              {item.value}
            </p>
            <p class="text-sm font-bold text-blue-300 uppercase tracking-wider">
              {item.label}
            </p>
          </div>

          <!-- Descripción -->
          <p class="text-sm text-blue-200/60 leading-relaxed mt-auto">
            {item.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Banner inferior -->
    <div
      data-reveal
      class="mt-12 bg-blue-900/60 border border-blue-700/50 rounded-2xl px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-5"
    >
      <div class="text-center sm:text-left">
        <p class="text-white font-bold text-lg">¿Listo para unirte a nosotros?</p>
        <p class="text-blue-300 text-sm mt-1">Inscripciones abiertas · Clases inician el <strong class="text-white">lunes 6 de abril</strong></p>
      </div>
      <a
        href="https://wa.me/51929469555?text=Hola,%20quiero%20información%20sobre%20las%20inscripciones"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-2 bg-green-500 hover:bg-green-400 text-white font-bold px-6 py-3 rounded-xl transition-all duration-200 hover:-translate-y-0.5 shadow-lg shadow-green-900/30"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
        Inscribirme ahora
      </a>
    </div>

  </div>
</section>

<script>
  import "../scripts/reveal.ts";
</script>
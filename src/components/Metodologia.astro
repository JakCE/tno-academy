---
// src/components/Metodologia.astro
import { Icon } from "astro-icon/components";
const lang = (Astro.currentLocale ?? "es") as "es" | "en";

const t = {
  es: {
    badge: "Metodología educativa",
    h2a: "Cómo",
    h2b: "formamos resultados reales",
    desc: "Aplicamos un sistema académico estructurado, enfocado en el progreso constante, la disciplina y el logro de objetivos concretos.",
    methods: [
      { title: "Enfoque intensivo en Matemática", description: "Desarrollamos el razonamiento lógico y la resolución estratégica de problemas desde primaria hasta nivel preuniversitario.", icon: "heroicons:calculator" },
      { title: "Seguimiento personalizado", description: "Monitoreamos el avance académico de cada estudiante mediante evaluaciones constantes y retroalimentación continua.", icon: "heroicons:clipboard-document-check" },
      { title: "Preparación especializada COAR y Universidad", description: "Simulacros, práctica dirigida y entrenamiento enfocado en exámenes de alto nivel.", icon: "heroicons:academic-cap" },
      { title: "Formación integral", description: "Complementamos Matemática con Comunicación y Computación para un desarrollo académico equilibrado.", icon: "heroicons:computer-desktop" },
    ],
    extra_h3: "Metodología enfocada en resultados",
    extra_desc: "No solo enseñamos teoría — entrenamos habilidades reales para enfrentar exámenes exigentes y lograr ingresos a instituciones de alto nivel.",
    extra_cta: "Solicitar información",
  },
  en: {
    badge: "Teaching methodology",
    h2a: "How we",
    h2b: "produce real results",
    desc: "We apply a structured academic system, focused on constant progress, discipline, and the achievement of concrete objectives.",
    methods: [
      { title: "Intensive Mathematics focus", description: "We develop logical reasoning and strategic problem solving from primary through pre-university level.", icon: "heroicons:calculator" },
      { title: "Personalized follow-up", description: "We monitor each student's academic progress through constant assessments and continuous feedback.", icon: "heroicons:clipboard-document-check" },
      { title: "Specialized COAR and University preparation", description: "Practice tests, guided study, and training focused on high-level exams.", icon: "heroicons:academic-cap" },
      { title: "Comprehensive education", description: "We complement Mathematics with Communication and Computing for balanced academic development.", icon: "heroicons:computer-desktop" },
    ],
    extra_h3: "Results-focused methodology",
    extra_desc: "We don't just teach theory — we train real skills to face demanding exams and gain admission to top-level institutions.",
    extra_cta: "Request information",
  },
}[lang];
---

<section id="metodologia" class="relative py-28 bg-white dark:bg-slate-900 overflow-hidden">
  <div class="absolute -top-32 -left-32 w-[500px] h-[500px] bg-blue-50 dark:bg-blue-950/20 rounded-full blur-[120px] opacity-60 pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-[500px] h-[500px] bg-blue-100 dark:bg-blue-900/10 rounded-full blur-[120px] opacity-40 pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-20" data-reveal>
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-blue-700 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 px-4 py-1.5 rounded-full mb-5">
        {t.badge}
      </span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-neutral-900 dark:text-white leading-tight">
        {t.h2a} <span class="text-blue-700 dark:text-blue-400">{t.h2b}</span>
      </h2>
      <p class="mt-5 text-neutral-500 dark:text-slate-400 text-base leading-relaxed">{t.desc}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 md:gap-8">
      {t.methods.map((method, i) => (
        <div data-reveal data-reveal-delay={String(i+1)}
          class="group relative flex gap-5 p-6 md:p-7 rounded-3xl border border-neutral-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:shadow-xl dark:hover:shadow-slate-900/50 hover:-translate-y-1 transition-all duration-300"
        >
          <span class="absolute top-5 right-5 text-6xl font-black opacity-[0.04] text-neutral-900 dark:text-white select-none">
            {String(i+1).padStart(2,"0")}
          </span>
          <div class="w-14 h-14 rounded-2xl bg-blue-50 dark:bg-blue-950/50 flex items-center justify-center flex-shrink-0 transition-all duration-300 group-hover:bg-blue-100 dark:group-hover:bg-blue-900/40">
            <Icon name={method.icon} class="w-6 h-6 text-blue-700 dark:text-blue-400" />
          </div>
          <div>
            <h3 class="text-lg md:text-xl font-extrabold text-neutral-900 dark:text-white leading-snug">{method.title}</h3>
            <p class="mt-2 text-sm md:text-base text-neutral-500 dark:text-slate-400 leading-relaxed">{method.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div data-reveal class="mt-20 bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800/50 rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-center md:text-left max-w-xl">
        <h3 class="text-xl md:text-2xl font-extrabold text-neutral-900 dark:text-white">{t.extra_h3}</h3>
        <p class="mt-3 text-neutral-600 dark:text-slate-400 text-sm md:text-base">{t.extra_desc}</p>
      </div>
      <a href="#contacto" class="shrink-0 inline-flex items-center gap-2 bg-blue-700 text-white font-bold px-6 py-3 rounded-xl hover:bg-blue-800 transition-all duration-200 shadow-md hover:-translate-y-0.5">
        {t.extra_cta}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
      </a>
    </div>
  </div>
</section>
<script>import "../scripts/reveal.ts";</script>

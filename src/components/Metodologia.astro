---
// src/components/Metodologia.astro
import { Icon } from "astro-icon/components";

const methods = [
  {
    title: "Enfoque intensivo en Matemática",
    description:
      "Desarrollamos el razonamiento lógico y la resolución estratégica de problemas desde primaria hasta nivel preuniversitario.",
    icon: "heroicons:calculator",
  },
  {
    title: "Seguimiento personalizado",
    description:
      "Monitoreamos el avance académico de cada estudiante mediante evaluaciones constantes y retroalimentación continua.",
    icon: "heroicons:clipboard-document-check",
  },
  {
    title: "Preparación especializada COAR y Universidad",
    description:
      "Simulacros, práctica dirigida y entrenamiento enfocado en exámenes de alto nivel.",
    icon: "heroicons:academic-cap",
  },
  {
    title: "Formación integral",
    description:
      "Complementamos Matemática con Comunicación y Computación para un desarrollo académico equilibrado.",
    icon: "heroicons:computer-desktop",
  },
];
---

<section id="metodologia" class="relative py-28 bg-white overflow-hidden">

  <!-- Background decor -->
  <div class="absolute -top-32 -left-32 w-[500px] h-[500px] bg-blue-50 rounded-full blur-[120px] opacity-60 pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-[500px] h-[500px] bg-blue-100 rounded-full blur-[120px] opacity-40 pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-6">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-20" data-reveal>
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-blue-700 bg-blue-50 border border-blue-200 px-4 py-1.5 rounded-full mb-5">
        Metodología educativa
      </span>

      <h2 class="text-3xl md:text-4xl font-extrabold text-neutral-900 leading-tight">
        Cómo <span class="text-blue-700">formamos resultados reales</span>
      </h2>

      <p class="mt-5 text-neutral-500 text-base leading-relaxed">
        Aplicamos un sistema académico estructurado, enfocado en el progreso constante,
        la disciplina y el logro de objetivos concretos.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid md:grid-cols-2 gap-6 md:gap-8">

      {methods.map((method, i) => (
        <div
          data-reveal
          data-reveal-delay={String(i + 1)}
          class="group relative flex gap-5 p-6 md:p-7 rounded-3xl border border-neutral-200 bg-white hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
        >

          <!-- Número decorativo -->
          <span class="absolute top-5 right-5 text-6xl font-black opacity-[0.04] text-neutral-900 select-none">
            {String(i + 1).padStart(2, "0")}
          </span>

          <!-- Icon -->
          <div class="w-14 h-14 rounded-2xl bg-blue-50 flex items-center justify-center flex-shrink-0 transition-all duration-300 group-hover:bg-blue-100">
            <Icon name={method.icon} class="w-6 h-6 text-blue-700" />
          </div>

          <!-- Content -->
          <div>
            <h3 class="text-lg md:text-xl font-extrabold text-neutral-900 leading-snug">
              {method.title}
            </h3>

            <p class="mt-2 text-sm md:text-base text-neutral-500 leading-relaxed">
              {method.description}
            </p>
          </div>

        </div>
      ))}

    </div>

    <!-- Extra highlight block -->
    <div
      data-reveal
      class="mt-20 bg-blue-50 border border-blue-200 rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6"
    >
      <div class="text-center md:text-left max-w-xl">
        <h3 class="text-xl md:text-2xl font-extrabold text-neutral-900">
          Metodología enfocada en resultados
        </h3>
        <p class="mt-3 text-neutral-600 text-sm md:text-base">
          No solo enseñamos teoría — entrenamos habilidades reales para
          enfrentar exámenes exigentes y lograr ingresos a instituciones de alto nivel.
        </p>
      </div>

      <a
        href="/#contacto"
        class="shrink-0 inline-flex items-center gap-2 bg-blue-700 text-white font-bold px-6 py-3 rounded-xl hover:bg-blue-800 transition-all duration-200 shadow-md shadow-blue-700/20 hover:shadow-lg hover:-translate-y-0.5"
      >
        Solicitar información
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  import "../scripts/reveal.ts";
</script>
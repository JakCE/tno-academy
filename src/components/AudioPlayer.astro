---
// src/components/AudioPlayer.astro
// Uso: <AudioPlayer audioSrc="/audio/cancion-tno.mp3" />
// Sube tu mp3 a: public/audio/cancion-tno.mp3

interface Props {
  audioSrc: string;
  title?: string;
}
const { audioSrc, title = "Himno — Academia The Number One" } = Astro.props;
---

<div class="bg-gradient-to-r from-blue-800 to-blue-600 rounded-2xl p-5 text-white max-w-md mx-auto shadow-lg shadow-blue-700/30">
  <!-- Fila principal -->
  <div class="flex items-center gap-4 mb-4">
    <!-- Ícono -->
    <div class="w-12 h-12 rounded-xl bg-white/15 flex items-center justify-center shrink-0">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
      </svg>
    </div>

    <!-- Info -->
    <div class="flex-1 min-w-0">
      <p class="text-[11px] uppercase tracking-widest text-blue-200 mb-0.5">🎵 Nuestra canción</p>
      <p class="text-sm font-semibold text-white truncate">{title}</p>
    </div>

    <!-- Botón play/pause -->
    <button
      id="tno-play"
      aria-label="Reproducir"
      class="w-11 h-11 rounded-full bg-white text-blue-700 flex items-center justify-center shrink-0 hover:bg-blue-50 transition-all hover:scale-105 active:scale-95"
    >
      <!-- Ícono play -->
      <svg id="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <!-- Ícono pause (oculto por defecto) -->
      <svg id="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="hidden">
        <rect x="6" y="4" width="4" height="16"></rect>
        <rect x="14" y="4" width="4" height="16"></rect>
      </svg>
    </button>
  </div>

  <!-- Barra de progreso -->
  <div class="flex items-center gap-3">
    <span id="tno-current" class="text-[11px] text-blue-200 tabular-nums w-8 text-right">0:00</span>

    <div
      id="tno-bar"
      class="flex-1 h-1 bg-white/25 rounded-full cursor-pointer relative"
    >
      <div
        id="tno-fill"
        class="h-full bg-white rounded-full"
        style="width: 0%"
      ></div>
    </div>

    <span id="tno-duration" class="text-[11px] text-blue-200 tabular-nums w-8">--:--</span>
  </div>

  <audio id="tno-audio" preload="metadata">
    <source src={audioSrc} type="audio/mpeg" />
  </audio>
</div>

<script>
  const audio    = document.getElementById("tno-audio")    as HTMLAudioElement;
  const playBtn  = document.getElementById("tno-play");
  const fill     = document.getElementById("tno-fill");
  const bar      = document.getElementById("tno-bar");
  const current  = document.getElementById("tno-current");
  const duration = document.getElementById("tno-duration");
  const iconPlay  = document.getElementById("icon-play");
  const iconPause = document.getElementById("icon-pause");

  function fmt(s: number) {
    const m = Math.floor(s / 60);
    return `${m}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
  }

  function setPlaying(playing: boolean) {
    iconPlay?.classList.toggle("hidden", playing);
    iconPause?.classList.toggle("hidden", !playing);
  }

  audio?.addEventListener("loadedmetadata", () => {
    if (duration) duration.textContent = fmt(audio.duration);
  });

  audio?.addEventListener("timeupdate", () => {
    if (!audio.duration) return;
    const pct = (audio.currentTime / audio.duration) * 100;
    if (fill) fill.style.width = pct + "%";
    if (current) current.textContent = fmt(audio.currentTime);
  });

  audio?.addEventListener("ended", () => {
    setPlaying(false);
    if (fill) fill.style.width = "0%";
    if (current) current.textContent = "0:00";
  });

  playBtn?.addEventListener("click", () => {
    if (audio?.paused) { audio.play(); setPlaying(true); }
    else               { audio?.pause(); setPlaying(false); }
  });

  bar?.addEventListener("click", (e) => {
    const rect  = bar.getBoundingClientRect();
    const ratio = (e.clientX - rect.left) / rect.width;
    if (audio) audio.currentTime = ratio * audio.duration;
  });
</script>
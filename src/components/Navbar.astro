---
// src/components/Navbar.astro
import { Icon } from "astro-icon/components";

const navItems = [
  { label: "Inicio",      href: "/"           },
  { label: "Programas",   href: "/#programas"  },
  { label: "Metodología", href: "/#metodologia"},
  { label: "Galería",     href: "/#galeria"    },
  { label: "Contacto",    href: "/#contacto"   },
];
---

<header
  id="navbar"
  class="fixed top-0 w-full z-40 transition-all duration-300"
>
  <!-- Barra principal -->
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="shrink-0 transition-opacity hover:opacity-80">
      <img
        src="/Logo Academia SF.png"
        alt="Academia The Number One — Atalaya, Ucayali"
        width="160" height="56"
        class="h-12 w-auto"
      />
    </a>

    <!-- Nav desktop -->
    <nav
      aria-label="Navegación principal"
      class="hidden lg:flex items-center gap-1"
    >
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link relative px-4 py-2 text-sm font-semibold text-neutral-600 hover:text-blue-700 rounded-xl hover:bg-blue-50 transition-all duration-200 group"
        >
          {item.label}
          <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-blue-600 rounded-full transition-all duration-300 group-hover:w-4"></span>
        </a>
      ))}
    </nav>

    <!-- CTA desktop -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href="https://wa.me/51929469555?text=Hola,%20quiero%20información%20sobre%20las%20inscripciones"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-semibold text-green-700 bg-green-50 border border-green-200 px-4 py-2 rounded-xl hover:bg-green-100 transition-all duration-200"
      >
        <Icon name="heroicons:chat-bubble-left-ellipsis" class="w-4 h-4" />
        WhatsApp
      </a>
      <a
        href="/#contacto"
        class="inline-flex items-center gap-2 bg-blue-700 text-white text-sm font-bold px-5 py-2.5 rounded-xl hover:bg-blue-800 transition-all duration-200 shadow-md shadow-blue-700/20 hover:shadow-lg hover:shadow-blue-700/30 hover:-translate-y-0.5"
      >
        <Icon name="heroicons:academic-cap" class="w-4 h-4" />
        Matrícula
      </a>
    </div>

    <!-- Botón hamburger mobile -->
    <button
      id="menu-btn"
      aria-label="Abrir menú"
      aria-expanded="false"
      class="lg:hidden w-10 h-10 flex items-center justify-center rounded-xl hover:bg-neutral-100 transition-colors"
    >
      <Icon name="heroicons:bars-3" class="w-6 h-6 text-neutral-700" />
    </button>

  </div>
</header>

<!-- Mobile menu (fuera del header para que sea full-screen) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden"
  aria-hidden="true"
>
  <!-- Backdrop -->
  <div id="mobile-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

  <!-- Panel -->
  <div
    id="mobile-panel"
    class="absolute right-0 top-0 h-full w-4/5 max-w-xs bg-white shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col"
  >
    <!-- Header del panel -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-neutral-100">
      <img
        src="/Logo Academia SF.png"
        alt="Academia The Number One"
        width="130" height="46"
        class="h-10 w-auto"
      />
      <button
        id="close-btn"
        aria-label="Cerrar menú"
        class="w-9 h-9 flex items-center justify-center rounded-xl bg-neutral-100 hover:bg-neutral-200 transition-colors"
      >
        <Icon name="heroicons:x-mark" class="w-5 h-5 text-neutral-700" />
      </button>
    </div>

    <!-- Links -->
    <nav class="flex-1 flex flex-col justify-center px-6 gap-1">
      {navItems.map((item, i) => (
        <a
          href={item.href}
          data-mobile-link
          class="flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-semibold text-neutral-700 hover:bg-blue-50 hover:text-blue-700 transition-all duration-200"
          style={`animation-delay: ${i * 0.06}s`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- CTAs -->
    <div class="px-6 pb-8 space-y-3 border-t border-neutral-100 pt-6">
      <a
        href="https://wa.me/51929469555?text=Hola,%20quiero%20información"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-green-600 text-white font-bold text-sm hover:bg-green-700 transition-colors"
      >
        <Icon name="heroicons:chat-bubble-left-ellipsis" class="w-4 h-4" />
        Escríbenos por WhatsApp
      </a>
      <a
        href="/#contacto"
        data-mobile-link
        class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-blue-700 text-white font-bold text-sm hover:bg-blue-800 transition-colors"
      >
        <Icon name="heroicons:academic-cap" class="w-4 h-4" />
        Matricularme ahora
      </a>
    </div>
  </div>
</div>

<script>
  const navbar      = document.getElementById("navbar")!;
  const menuBtn     = document.getElementById("menu-btn")!;
  const closeBtn    = document.getElementById("close-btn")!;
  const mobileMenu  = document.getElementById("mobile-menu")!;
  const panel       = document.getElementById("mobile-panel")!;
  const backdrop    = document.getElementById("mobile-backdrop")!;
  const mobileLinks = document.querySelectorAll("[data-mobile-link]");

  // ── Scroll effect en navbar ──
  function updateNavbar() {
    const scrolled = window.scrollY > 20;
    navbar.classList.toggle("bg-white",           scrolled);
    navbar.classList.toggle("shadow-sm",          scrolled);
    navbar.classList.toggle("border-b",           scrolled);
    navbar.classList.toggle("border-neutral-100", scrolled);
    navbar.classList.toggle("bg-white/80",        !scrolled);
    navbar.classList.toggle("backdrop-blur-md",   !scrolled);
  }
  updateNavbar();
  window.addEventListener("scroll", updateNavbar, { passive: true });

  // ── Mobile menu ──
  function openMenu() {
    mobileMenu.classList.remove("hidden");
    mobileMenu.setAttribute("aria-hidden", "false");
    menuBtn.setAttribute("aria-expanded", "true");
    // Trigger animation
    requestAnimationFrame(() => {
      backdrop.classList.remove("opacity-0");
      backdrop.classList.add("opacity-100");
      panel.classList.remove("translate-x-full");
      panel.classList.add("translate-x-0");
    });
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    backdrop.classList.remove("opacity-100");
    backdrop.classList.add("opacity-0");
    panel.classList.remove("translate-x-0");
    panel.classList.add("translate-x-full");
    menuBtn.setAttribute("aria-expanded", "false");
    setTimeout(() => {
      mobileMenu.classList.add("hidden");
      mobileMenu.setAttribute("aria-hidden", "true");
    }, 300);
    document.body.style.overflow = "";
  }

  menuBtn.addEventListener("click", openMenu);
  closeBtn.addEventListener("click", closeMenu);
  backdrop.addEventListener("click", closeMenu);
  mobileLinks.forEach(link => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeMenu(); });
</script>
---
// src/components/Navbar.astro
import { Icon } from "astro-icon/components";

interface Props {
  navItems?: { label: string; href: string }[];
  ctaPrimary?: { label: string; href: string };
}

const lang = Astro.currentLocale ?? "es";

// Switcher de idioma
const path = Astro.url.pathname;
const alternateLang = lang === "es" ? "en" : "es";
const alternatePath =
  lang === "es"
    ? `/en${path === "/" ? "" : path}`
    : path.replace(/^\/en/, "") || "/";

const labels = {
  es: { whatsapp: "WhatsApp", langSwitch: "EN" },
  en: { whatsapp: "WhatsApp", langSwitch: "ES" },
}[lang as "es" | "en"];

const isAcademia = path === "/academia" || path === "/en/academia";
const logoSrc = isAcademia ? "/Logo Academia SF.png" : "/se_logo-sf.png";
const logoAlt = isAcademia ? "Academia The Number One — Atalaya, Ucayali" : "Servicios Educativos The Number One";

const {
  navItems = lang === "en"
    ? [
        { label: "Home",        href: "#inicio"      },
        { label: "Programs",    href: "#programas"   },
        { label: "Methodology", href: "#metodologia" },
        { label: "Gallery",     href: "#galeria"     },
        { label: "Contact",     href: "#contacto"    },
      ]
    : [
        { label: "Inicio",      href: "#inicio"      },
        { label: "Programas",   href: "#programas"   },
        { label: "Metodología", href: "#metodologia" },
        { label: "Galería",     href: "#galeria"     },
        { label: "Contacto",    href: "#contacto"    },
      ],
  ctaPrimary =
    lang === "en"
      ? { label: "Enroll", href: "#contacto" }
      : { label: "Matrícula", href: "#contacto" },
} = Astro.props;
---

<header id="navbar" class="fixed top-0 w-full z-40 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">

    <!-- Logo -->
    <a href={lang === "en" ? "/en" : "/"} class="shrink-0 transition-opacity hover:opacity-80">
      <img
        src={logoSrc}
        alt={logoAlt}
        width="160" height="56"
        class="h-12 w-auto dark:brightness-125"
      />
    </a>

    <!-- Nav desktop -->
    <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link relative px-4 py-2 text-sm font-semibold text-neutral-600 dark:text-slate-300 hover:text-blue-700 dark:hover:text-blue-400 rounded-xl hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-all duration-200 group"
        >
          {item.label}
          <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-blue-600 rounded-full transition-all duration-300 group-hover:w-4"></span>
        </a>
      ))}
    </nav>

    <!-- CTAs desktop -->
    <div class="hidden lg:flex items-center gap-2">

      <!-- Switcher idioma -->
      <a
        href={alternatePath}
        aria-label={`Switch to ${alternateLang === "en" ? "English" : "Español"}`}
        class="w-9 h-9 rounded-xl flex items-center justify-center text-xs font-bold text-neutral-500 dark:text-slate-400 hover:bg-neutral-100 dark:hover:bg-slate-700 hover:text-blue-700 dark:hover:text-blue-400 border border-neutral-200 dark:border-slate-600 transition-all duration-200"
      >
        {labels.langSwitch}
      </a>

      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        aria-label="Cambiar tema"
        class="w-9 h-9 rounded-xl flex items-center justify-center text-neutral-500 dark:text-slate-400 hover:bg-neutral-100 dark:hover:bg-slate-700 transition-all duration-200"
      >
        <!-- Sol (visible en modo oscuro) -->
        <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
        <!-- Luna (visible en modo claro) -->
        <svg id="icon-moon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
      </button>

      <!-- WhatsApp -->
      <a
        href="https://wa.me/51929469555?text=Hola,%20quiero%20información%20sobre%20las%20inscripciones"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-semibold text-green-700 dark:text-green-400 bg-green-50 dark:bg-green-950/40 border border-green-200 dark:border-green-800 px-4 py-2 rounded-xl hover:bg-green-100 dark:hover:bg-green-900/40 transition-all duration-200"
      >
        <Icon name="heroicons:chat-bubble-left-ellipsis" class="w-4 h-4" />
        {labels.whatsapp}
      </a>

      <!-- CTA matrícula -->
      <a
        href={ctaPrimary.href}
        class="inline-flex items-center gap-2 bg-blue-700 text-white text-sm font-bold px-5 py-2.5 rounded-xl hover:bg-blue-800 transition-all duration-200 shadow-md shadow-blue-700/20 hover:-translate-y-0.5"
      >
        <Icon name="heroicons:academic-cap" class="w-4 h-4" />
        {ctaPrimary.label}
      </a>
    </div>

    <!-- Hamburger mobile -->
    <div class="lg:hidden flex items-center gap-2">
      <!-- Lang switch mobile -->
      <a
        href={alternatePath}
        class="w-9 h-9 rounded-xl flex items-center justify-center text-xs font-bold text-neutral-500 dark:text-slate-400 border border-neutral-200 dark:border-slate-600 hover:bg-neutral-100 dark:hover:bg-slate-700 transition-all"
      >
        {labels.langSwitch}
      </a>
      <!-- Dark toggle mobile -->
      <button
        id="theme-toggle-mobile"
        aria-label="Cambiar tema"
        class="w-9 h-9 rounded-xl flex items-center justify-center text-neutral-500 dark:text-slate-400 hover:bg-neutral-100 dark:hover:bg-slate-700 transition-all"
      >
        <svg id="icon-sun-m" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
        <svg id="icon-moon-m" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
      </button>
      <button
        id="menu-btn"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="w-10 h-10 flex items-center justify-center rounded-xl hover:bg-neutral-100 dark:hover:bg-slate-700 transition-colors"
      >
        <Icon name="heroicons:bars-3" class="w-6 h-6 text-neutral-700 dark:text-slate-300" />
      </button>
    </div>

  </div>
</header>

<!-- Mobile menu -->
<div id="mobile-menu" class="fixed inset-0 z-50 hidden" aria-hidden="true">
  <div id="mobile-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
  <div id="mobile-panel" class="absolute right-0 top-0 h-full w-4/5 max-w-xs bg-white dark:bg-slate-900 shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col">

    <div class="flex items-center justify-between px-6 py-5 border-b border-neutral-100 dark:border-slate-700">
      <img src={logoSrc} alt={logoAlt} width="130" height="46" class="h-10 w-auto dark:brightness-125" />
      <button id="close-btn" aria-label="Cerrar menú" class="w-9 h-9 flex items-center justify-center rounded-xl bg-neutral-100 dark:bg-slate-700 hover:bg-neutral-200 dark:hover:bg-slate-600 transition-colors">
        <Icon name="heroicons:x-mark" class="w-5 h-5 text-neutral-700 dark:text-slate-300" />
      </button>
    </div>

    <nav class="flex-1 flex flex-col justify-center px-6 gap-1">
      {navItems.map((item, i) => (
        <a
          href={item.href}
          data-mobile-link
          class="flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-semibold text-neutral-700 dark:text-slate-200 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-700 dark:hover:text-blue-400 transition-all duration-200"
          style={`animation-delay: ${i * 0.06}s`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="px-6 pb-8 space-y-3 border-t border-neutral-100 dark:border-slate-700 pt-6">
      <a
        href="https://wa.me/51929469555?text=Hola,%20quiero%20información"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-green-600 text-white font-bold text-sm hover:bg-green-700 transition-colors"
      >
        <Icon name="heroicons:chat-bubble-left-ellipsis" class="w-4 h-4" />
        WhatsApp
      </a>
      <a
        href={ctaPrimary.href}
        data-mobile-link
        class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-blue-700 text-white font-bold text-sm hover:bg-blue-800 transition-colors"
      >
        <Icon name="heroicons:academic-cap" class="w-4 h-4" />
        {ctaPrimary.label}
      </a>
    </div>
  </div>
</div>

<script>
  const navbar      = document.getElementById("navbar")!;
  const menuBtn     = document.getElementById("menu-btn")!;
  const closeBtn    = document.getElementById("close-btn")!;
  const mobileMenu  = document.getElementById("mobile-menu")!;
  const panel       = document.getElementById("mobile-panel")!;
  const backdrop    = document.getElementById("mobile-backdrop")!;
  const mobileLinks = document.querySelectorAll("[data-mobile-link]");

  // ── Scroll effect ──
  function updateNavbar() {
    const scrolled = window.scrollY > 20;
    navbar.classList.toggle("bg-white",                  scrolled);
    navbar.classList.toggle("dark:bg-slate-900",         scrolled);
    navbar.classList.toggle("shadow-sm",                 scrolled);
    navbar.classList.toggle("border-b",                  scrolled);
    navbar.classList.toggle("border-neutral-100",        scrolled);
    navbar.classList.toggle("dark:border-slate-700",     scrolled);
    navbar.classList.toggle("bg-white/80",               !scrolled);
    navbar.classList.toggle("dark:bg-slate-900/80",      !scrolled);
    navbar.classList.toggle("backdrop-blur-md",          !scrolled);
  }
  updateNavbar();
  window.addEventListener("scroll", updateNavbar, { passive: true });

  // ── Mobile menu ──
  function openMenu() {
    mobileMenu.classList.remove("hidden");
    mobileMenu.setAttribute("aria-hidden", "false");
    menuBtn.setAttribute("aria-expanded", "true");
    requestAnimationFrame(() => {
      backdrop.classList.replace("opacity-0", "opacity-100");
      panel.classList.replace("translate-x-full", "translate-x-0");
    });
    document.body.style.overflow = "hidden";
  }
  function closeMenu() {
    backdrop.classList.replace("opacity-100", "opacity-0");
    panel.classList.replace("translate-x-0", "translate-x-full");
    menuBtn.setAttribute("aria-expanded", "false");
    setTimeout(() => {
      mobileMenu.classList.add("hidden");
      mobileMenu.setAttribute("aria-hidden", "true");
    }, 300);
    document.body.style.overflow = "";
  }
  menuBtn.addEventListener("click", openMenu);
  closeBtn.addEventListener("click", closeMenu);
  backdrop.addEventListener("click", closeMenu);
  mobileLinks.forEach(l => l.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeMenu(); });

  // ── Dark mode toggle ──
  function syncIcons(isDark: boolean) {
    document.getElementById("icon-sun")!.classList.toggle("hidden", !isDark);
    document.getElementById("icon-moon")!.classList.toggle("hidden", isDark);
    document.getElementById("icon-sun-m")!.classList.toggle("hidden", !isDark);
    document.getElementById("icon-moon-m")!.classList.toggle("hidden", isDark);
  }

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    syncIcons(isDark);
  }

  // Sync icons on load
  syncIcons(document.documentElement.classList.contains("dark"));

  document.getElementById("theme-toggle")!.addEventListener("click", toggleTheme);
  document.getElementById("theme-toggle-mobile")!.addEventListener("click", toggleTheme);
</script>

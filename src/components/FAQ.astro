---
// src/components/FAQ.astro
const faqs = [
  {
    q: "¿Qué niveles educativos atienden?",
    a: "Brindamos nivelación y reforzamiento académico para estudiantes de primaria y secundaria, así como preparación preuniversitaria.",
  },
  {
    q: "¿Qué tipo de preparación ofrecen?",
    a: "Contamos con preparación especializada para COAR, Beca 18 y exámenes de admisión universitarios, con simulacros y práctica intensiva.",
  },
  {
    q: "¿Qué cursos dictan?",
    a: "En Matemáticas enseñamos Aritmética, Álgebra, Geometría, Trigonometría y Razonamiento Matemático. En Letras, Comunicación, Comprensión Lectora e Inglés.",
  },
  {
    q: "¿Dónde están ubicados?",
    a: "Nos encontramos en Jr. Rímac Mz 23 Lt 1f, frente a la IE Hildebrando Fuentes (Referencia: Librería San Antonio, 1er piso), en Atalaya, Ucayali.",
  },
  {
    q: "¿Cómo puedo inscribirme?",
    a: "Puedes inscribirte escribiéndonos por WhatsApp o llamando a cualquiera de nuestros números. Nuestro equipo te brindará toda la información necesaria.",
  },
  {
    q: "¿Cuándo inician las clases?",
    a: "Las clases inician este lunes 6 de abril. Te recomendamos inscribirte con anticipación para asegurar tu vacante.",
  },
  {
    q: "¿Cómo puedo contactarlos?",
    a: "Puedes llamarnos o escribirnos a los siguientes números: 929 469 555, 949 544 537 o 907 383 283.",
  },
  {
    q: "¿Por qué elegir Academia The Number One?",
    a: "Contamos con más de 10 años de experiencia formando estudiantes, metodología enfocada en resultados y preparación especializada para COAR, Beca 18 y universidades."
  },
];
---

<section id="faq" class="py-28 bg-neutral-50">

  <div class="max-w-4xl mx-auto px-6">

    <!-- Header -->
    <div class="text-center mb-16" data-reveal>
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-blue-700 bg-blue-50 border border-blue-200 px-4 py-1.5 rounded-full mb-5">
        Preguntas frecuentes
      </span>

      <h2 class="text-3xl md:text-4xl font-extrabold text-neutral-900">
        Resolvemos tus <span class="text-blue-700">dudas</span>
      </h2>
    </div>

    <!-- Acordeón -->
    <div class="space-y-4">

      {faqs.map((item, i) => (
        <div
          data-reveal
          data-reveal-delay={String(i + 1)}
          class="border border-neutral-200 rounded-2xl bg-white overflow-hidden"
        >

          <button
            class="faq-btn w-full flex items-center justify-between px-6 py-4 text-left"
          >
            <span class="font-semibold text-neutral-900">{item.q}</span>
            <span class="text-blue-700">+</span>
          </button>

          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 px-6">
            <p class="py-4 text-sm text-neutral-600">
              {item.a}
            </p>
          </div>

        </div>
      ))}

    </div>

  </div>
</section>

<script>
  import "../scripts/reveal.ts";

  const buttons = document.querySelectorAll(".faq-btn");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const content = btn.nextElementSibling as HTMLElement | null;

      if (!content) return;

      if (content.style.maxHeight) {
        content.style.maxHeight = "";
      } else {
        document.querySelectorAll(".faq-content").forEach((c) => {
          (c as HTMLElement).style.maxHeight = "";
        });

        content.style.maxHeight = content.scrollHeight + "px";
      }
    });
  });
</script>
---
// src/layouts/Layout.astro
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import AnnouncementModal from "../components/AnnouncementModal.astro";
import Analytics from "@vercel/analytics/astro";
import FloatingActions from "../components/FloatingActions.astro";


interface Props {
  title?: string;
  description?: string;
  navItems?: { label: string; href: string }[];
  ctaPrimary?: { label: string; href: string };
  footerBrand?: string;
  footerBrandDescription?: string;
  footerQuickLinks?: { label: string; href: string }[];
  showModal?: boolean;
}

const {
  title       = "Academia The Number One",
  description = "Academia educativa enfocada en la excelencia académica y formación integral.",
  navItems,
  ctaPrimary,
  footerBrand,
  footerBrandDescription,
  footerQuickLinks,
  showModal = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Canonical -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={Astro.url.href} />
    <meta property="og:image"       content="https://thenumberone.com.pe/Logo Academia SF.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Dark mode: prevenir flash antes de que cargue CSS -->
    <script is:inline>
      (function(){
        var t = localStorage.getItem('theme');
        var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (t === 'dark' || (!t && d)) document.documentElement.classList.add('dark');
      })();
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-53V7LT6M');
    </script>
    <!-- End Google Tag Manager -->

    <!-- SEO Local mejorado -->
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "Academia The Number One",
        "url": "https://thenumberone.com.pe",
        "telephone": ["+51929469555", "+51949544537", "+51907383283"],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Jr. Rímac Mz 23 Lt 1f",
          "addressLocality": "Atalaya",
          "addressRegion": "Ucayali",
          "addressCountry": "PE"
        },
        "description": "Academia de reforzamiento escolar y preparación preuniversitaria en Atalaya, Ucayali. COAR, Beca 18, Matemáticas y Letras."
      })}
    </script>

    <!-- Fuentes: Sora (títulos) + Nunito (cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Nunito:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/icono.ico" />

    <!-- Tailwind: fuentes como variables CSS para usarlas en tailwind.config -->
    <style>
      :root {
        --font-heading: 'Sora', sans-serif;
        --font-body:    'Nunito', sans-serif;
      }
      body { font-family: var(--font-body); }
      h1, h2, h3, h4, h5, h6 { font-family: var(--font-heading); }
    </style>
  </head>

  <body class="bg-white dark:bg-slate-950 text-gray-800 dark:text-slate-200 antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-53V7LT6M"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Modal de anuncio (solo en academia) -->
    {showModal && <AnnouncementModal />}

    <!-- Navbar -->
    <Navbar navItems={navItems} ctaPrimary={ctaPrimary} />

    <!-- Contenido principal -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <Footer brand={footerBrand} brandDescription={footerBrandDescription} quickLinks={footerQuickLinks} />
    <FloatingActions />
    <Analytics />
  </body>
</html>